# Másold .env néven, és töltsd ki. A .env-et a .gitignore kizárja.

# --- Környezet ------------------------------------------------------------
# sandbox vagy production
ALLEGRO_ENV=sandbox

# --- Alkalmazás -----------------------------------------------------------
# Az apps.developer.allegro.pl (illetve a sandbox párja) oldalon regisztrált
# alkalmazás adatai. FIGYELEM: az éles és a sandbox alkalmazás KÜLÖN entitás,
# külön kulcsokkal.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=

# --- User-Agent (KÖTELEZŐ) ------------------------------------------------
# A REST API Szabályzat 3.4(c) pontja megköveteli. Az alkalmazásnévnek
# egyeznie kell a regisztrált alkalmazás nevével, az URL-nek pedig egy
# elérhető információs oldalra kell mutatnia.
# Formátum:  Nev/Verzio (+https://url)
# Validátor: https://apps.developer.allegro.pl/user-agent
# NE változtasd feleslegesen – fehérlistázási tényezőként használják.
ALLEGRO_USER_AGENT="formeAllegroSync/1.0.0 (+https://forme.hu/allegro-sync)"

# --- Nyelv ----------------------------------------------------------------
# Támogatott: hu-HU, en-US, pl-PL, cs-CZ, sk-SK, uk-UA
ALLEGRO_LANGUAGE=hu-HU

# --- Kéréskorlát ----------------------------------------------------------
# Az Allegro főlimitje 9000 kérés/perc Client ID-nként. Alapból ennek a
# feléből indulunk, hogy a párhuzamos futások se sodorjanak limitbe.
ALLEGRO_RATE_LIMIT_PER_MINUTE=4000

# --- Temu Open Platform (EU) ---------------------------------------------
# A Seller Center / Partner Platform alkalmazás App Key, App Secret és
# eladói engedélyezés után kapott Access Token értéke.
TEMU_ENDPOINT=https://openapi-b-eu.temu.com/openapi/router
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=

# --- Számlázás -------------------------------------------------------------
# A számlázó modul alapból ki van kapcsolva.
# Bekapcsolás: INVOICE_DRIVER=szamlazz
INVOICE_DRIVER=none
SZAMLAZZ_AGENT_KEY=
SZAMLAZZ_INVOICE_PREFIX=
# false: csak az Allegro értesíti a vevőt; true: a Számlázz.hu is küld másodpéldányt
SZAMLAZZ_SEND_EMAIL=false
